# Bu dosyayı .env olarak kopyalayıp değerleri doldur. .env git'e girmez.

# JWT imzalama anahtarı (en az 32 bayt). Üretmek için: openssl rand -base64 32
JWT_SECRET=

# İlk açılışta oluşturulan admin kullanıcısı (kullanıcı tablosu boşken uygulanır)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Veritabanı şifresi. Postgres volume'u ilk oluşturulurken uygulanır; sonradan değiştirmek
# mevcut veritabanının şifresini değiştirmez. Üretmek için: openssl rand -base64 24
DB_PASSWORD=

# Cloudflare Turnstile secret key. frontend/assets/js/config.js'teki site key ile aynı widget'a ait olmalı.
TURNSTILE_SECRET=

# İsteğe bağlı: Turnstile token'ının kabul edildiği alan adları (varsayılan bahadiralper.com,www.bahadiralper.com)
# TURNSTILE_ALLOWED_HOSTNAMES=bahadiralper.com,www.bahadiralper.com

# İsteğe bağlı: backend konteynerinin bellek sınırı (varsayılan 768m; JVM bunun %75'ini kullanır)
# BACKEND_MEMORY=768m

# --- Yalnızca yerel geliştirme (canlıda bu satırları yazma) ---
# nginx'in host portu (canlıda varsayılan 80)
# NGINX_PORT=3000
# 5432 ve 8080'i 127.0.0.1'e açan geliştirme dosyasını otomatik ekle
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Yerelde Turnstile token'ı localhost'ta üretilir
# TURNSTILE_ALLOWED_HOSTNAMES=localhost
